<UserControl x:Class="CAR_SERVICE_EF_RIDER.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md ="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CAR_SERVICE_EF_RIDER.Views"
             xmlns:models="clr-namespace:CAR_SERVICE_EF_RIDER.Models"

             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    <!-- Second color : #ADD8E6 -->
    <!-- Main color : #0f111a -->
    <Grid  Background="Transparent">
        
        <Border  Name="AnimatedBorder"  Background="WhiteSmoke"  CornerRadius="50" Margin="170,60,150,30">
            
            <Border.Effect>
                     
                <DropShadowEffect/>
                     
            </Border.Effect>

            <Grid>
                
                <Grid.RowDefinitions>
                    
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    
                </Grid.RowDefinitions>
                
                
                
                <Image Grid.Row="0" Grid.RowSpan="2" Source="../Images/ApexAuto(Main_Logo).png"></Image>

                <TextBlock Grid.Row="1" FontStyle="Italic" FontWeight="SemiBold" FontSize="60" HorizontalAlignment="Center" Margin="9,60,0,0" Text="REGISTER "> </TextBlock>

                <TextBox Name="UserNameTextBox" Text="{Binding UserName, UpdateSourceTrigger=Default}" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}"  HorizontalAlignment="Center" Margin="11,0,0,135" Width="300"  FontSize="11">
                    
                    
                    <md:HintAssist.Hint>
                        <TextBlock>👤Username</TextBlock>
                    </md:HintAssist.Hint>
                    
                </TextBox>
                
                <TextBox  Name="MailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}" HorizontalAlignment="Center" Margin="11,45,0,90" Width="300"  FontSize="11">
                    
                    <md:HintAssist.Hint>
                        <TextBlock>✉Email</TextBlock>
                    </md:HintAssist.Hint>
                    
                </TextBox>
                
                <PasswordBox Name="UserPasswordBox" models:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Grid.Row="2"   HorizontalAlignment="Center" Margin="11,90,0,45" Width="300"  FontSize="11">
                    
                    <md:HintAssist.Hint>
                        <TextBlock>🔑Password</TextBlock>
                    </md:HintAssist.Hint>
                    
                </PasswordBox>
                
                <PasswordBox Name="UserConfirmPassworBox" models:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Grid.Row="2"   HorizontalAlignment="Center" Margin="11,135,0,0" Width="300"  FontSize="11">
                    
                    <md:HintAssist.Hint>
                        <TextBlock>🔑Confirm The Password</TextBlock>
                    </md:HintAssist.Hint>
                    
                </PasswordBox>

            <Button  Grid.Row="3" Name="EnterRegisterButton" Command="{Binding RegisterCommand, UpdateSourceTrigger=PropertyChanged}" Content="Register" Background="Transparent"  HorizontalAlignment="Center">
                
                <Button.Effect>
                    
                    <DropShadowEffect />
                    
                </Button.Effect>
                
            </Button>
                
                <TextBlock Grid.Row="3" HorizontalAlignment="Center" Margin="0,110,0,40" Text="Have an account?">
                    
                    <Hyperlink  Command="{Binding HaveAccountCommand}" Style="{StaticResource MaterialDesignCaptionHyperlink}">LogIn</Hyperlink>
                    
                </TextBlock>
                
                
                
            </Grid>
            
        </Border>
        
        <!--Animation of Border's appearance -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Grid.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="AnimatedBorder"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:1.500"/>
                        <DoubleAnimation Storyboard.TargetName="AnimatedBorder"
                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         From="0.5" To="1" Duration="0:0:1.500"/>
                        <DoubleAnimation Storyboard.TargetName="AnimatedBorder"
                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         From="0.5" To="1" Duration="0:0:1.500"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        
    </Grid>
    
</UserControl>

