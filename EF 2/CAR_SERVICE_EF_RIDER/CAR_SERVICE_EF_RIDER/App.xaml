<Application x:Class="CAR_SERVICE_EF_RIDER.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CAR_SERVICE_EF_RIDER"
             xmlns:Views="clr-namespace:CAR_SERVICE_EF_RIDER.Views"
             xmlns:ViewModels="clr-namespace:CAR_SERVICE_EF_RIDER.ViewModels"
             StartupUri="Views/MainWindowView.xaml">
    
    <Application.Resources>
        
        <ResourceDictionary>
            
            <DataTemplate DataType="{x:Type ViewModels:RegisterViewModel}">
                <Views:RegisterView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:LogInViewModel }">
                <Views:LogInView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:UserMainViewModel}">
                <Views:UserMainView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:ForgotPasswordViewModel}">
                <Views:ForgotPasswordView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:VerifyCodeViewModel}">
                <Views:VerifyCodeView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:NewPasswordViewModel}">
                <Views:NewPasswordView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:CreateAdViewModel}">
                <Views:CreateAdView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:AdminMainViewModel}">
                <Views:AdminMainView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:AdminUserControlViewModel}">
                <Views:AdminUserControlView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type ViewModels:AdminProductControlViewModel}">
                <Views:AdminProductControlView/>
            </DataTemplate>
            
            <ResourceDictionary.MergedDictionaries>
                
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
        
    </Application.Resources>
    
    
    
</Application>
